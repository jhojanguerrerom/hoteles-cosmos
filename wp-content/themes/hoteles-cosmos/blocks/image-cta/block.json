{
    "apiVersion": 3,
    "name": "hoteles-cosmos/image-cta",
    "title": "Image CTA",
    "category": "cosmos",
    "icon": "format-image",
    "description": "Dos cards con imagen superior y botón CTA inferior.",
    "keywords": [
        "image",
        "cta",
        "cards",
        "imagen",
        "boton",
        "hoteles",
        "cosmos"
    ],
    "textdomain": "hoteles-cosmos",
    "supports": {
        "anchor": true,
        "html": false
    },
    "attributes": {
        "marginTop": {
            "type": "number",
            "default": 50
        },
        "marginBottom": {
            "type": "number",
            "default": 50
        },
        "cardGap": {
            "type": "number",
            "default": 30
        },
        "imageAspectRatio": {
            "type": "string",
            "default": "4/3"
        },
        "buttonBackgroundColor": {
            "type": "string",
            "default": "#111111"
        },
        "buttonTextColor": {
            "type": "string",
            "default": "#ffffff"
        },
        "buttonBorderColor": {
            "type": "string",
            "default": "#111111"
        },
        "buttonBorderRadius": {
            "type": "number",
            "default": 0
        },
        "buttonBorderWidth": {
            "type": "number",
            "default": 1
        },
        "buttonHeight": {
            "type": "number",
            "default": 55
        },
        "cards": {
            "type": "array",
            "default": [
                {
                    "imageId": 0,
                    "imageUrl": "",
                    "imageAlt": "",
                    "buttonText": "Conoce más",
                    "buttonUrl": ""
                },
                {
                    "imageId": 0,
                    "imageUrl": "",
                    "imageAlt": "",
                    "buttonText": "Conoce más",
                    "buttonUrl": ""
                }
            ]
        }
    },
    "editorScript": "file:./build/editor.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "render": "file:./render.php"
}