{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hoteles-cosmos/info-carousel",
    "title": "Información Carrusel Cosmos",
    "category": "cosmos",
    "icon": "list-view",
    "description": "Carrusel infinito de tarjetas de información con iconos y listas.",
    "keywords": [
        "información",
        "cards",
        "carrusel",
        "carousel",
        "iconos",
        "lista",
        "cosmos"
    ],
    "textdomain": "hoteles-cosmos",

    "supports": {
        "anchor": true,
        "html": false
    },

    "attributes": {

        "cards": {
            "type": "array",
            "default": [
                {
                    "id": 0,
                    "iconId": 0,
                    "iconUrl": "",
                    "iconAlt": "",
                    "title": "Título",
                    "items": [
                        "Elemento de información",
                        "Otro elemento"
                    ]
                },
                {
                    "id": 1,
                    "iconId": 0,
                    "iconUrl": "",
                    "iconAlt": "",
                    "title": "Título",
                    "items": [
                        "Elemento de información",
                        "Otro elemento"
                    ]
                },
                {
                    "id": 2,
                    "iconId": 0,
                    "iconUrl": "",
                    "iconAlt": "",
                    "title": "Título",
                    "items": [
                        "Elemento de información",
                        "Otro elemento"
                    ]
                },
                {
                    "id": 3,
                    "iconId": 0,
                    "iconUrl": "",
                    "iconAlt": "",
                    "title": "Título",
                    "items": [
                        "Elemento de información",
                        "Otro elemento"
                    ]
                }
            ]
        },

        "contentWidth": {
            "type": "string",
            "default": "container"
        },

        "cardBackground": {
            "type": "string",
            "default": "#ffffff"
        },

        "cardHasBackground": {
            "type": "boolean",
            "default": true
        },

        "cardBorderColor": {
            "type": "string",
            "default": "#dddddd"
        },

        "cardBorderWidth": {
            "type": "number",
            "default": 1
        },

        "cardBorderRadius": {
            "type": "number",
            "default": 0
        },

        "cardPadding": {
            "type": "number",
            "default": 30
        },

        "iconSize": {
            "type": "number",
            "default": 42
        },

        "iconTitleGap": {
            "type": "number",
            "default": 15
        },

        "titleColor": {
            "type": "string",
            "default": "#111111"
        },

        "titleFontSize": {
            "type": "number",
            "default": 22
        },

        "titleWeight": {
            "type": "number",
            "default": 600
        },

        "listColor": {
            "type": "string",
            "default": "#333333"
        },

        "listFontSize": {
            "type": "number",
            "default": 16
        },

        "listWeight": {
            "type": "number",
            "default": 400
        },

        "listGap": {
            "type": "number",
            "default": 8
        },

        "cardGap": {
            "type": "number",
            "default": 30
        },

        "marginTop": {
            "type": "number",
            "default": 50
        },

        "marginBottom": {
            "type": "number",
            "default": 50
        },

        "showArrows": {
            "type": "boolean",
            "default": true
        },

        "arrowColor": {
            "type": "string",
            "default": "#ffffff"
        },

        "arrowBackground": {
            "type": "string",
            "default": "#111111"
        },

        "arrowSize": {
            "type": "number",
            "default": 42
        }
    },

    "editorScript": "file:./build/editor.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "viewScript": "file:./view.js",
    "render": "file:./render.php"
}