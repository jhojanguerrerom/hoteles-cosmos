{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hoteles-cosmos/two-column-text",
    "title": "Texto en dos columnas (100%)",
    "category": "cosmos",
    "icon": "columns",
    "description": "Bloque de texto a ancho completo con dos columnas configurables.",
    "keywords": [
        "texto",
        "columnas",
        "dos columnas",
        "contenido",
        "cosmos"
    ],
    "textdomain": "hoteles-cosmos",

    "supports": {
        "anchor": true,
        "html": false
    },

    "attributes": {

        "backgroundColor": {
            "type": "string",
            "default": "#ffffff"
        },

        "paddingTop": {
            "type": "number",
            "default": 80
        },

        "paddingBottom": {
            "type": "number",
            "default": 80
        },

        "blockMarginTop": {
            "type": "number",
            "default": 0
        },

        "blockMarginBottom": {
            "type": "number",
            "default": 0
        },

        "columnGap": {
            "type": "number",
            "default": 60
        },

        "leftColumnWidth": {
            "type": "number",
            "default": 60
        },

        "leftText": {
            "type": "string",
            "default": "Nuestro propósito"
        },

        "leftTextColor": {
            "type": "string",
            "default": "#111111"
        },

        "leftTextSize": {
            "type": "number",
            "default": 42
        },

        "leftTextWeight": {
            "type": "string",
            "default": "400"
        },

        "leftTextAlign": {
            "type": "string",
            "default": "left"
        },

        "rightText": {
            "type": "string",
            "default": "Creamos experiencias y oportunidades que generan valor para nuestros aliados y sus proyectos."
        },

        "rightTextColor": {
            "type": "string",
            "default": "#333333"
        },

        "rightTextSize": {
            "type": "number",
            "default": 18
        },

        "rightTextWeight": {
            "type": "string",
            "default": "400"
        },

        "rightTextAlign": {
            "type": "string",
            "default": "left"
        }
    },

    "editorScript": "file:./build/editor.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "render": "file:./render.php"
}