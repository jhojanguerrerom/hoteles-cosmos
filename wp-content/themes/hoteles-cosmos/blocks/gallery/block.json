{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hoteles-cosmos/gallery",
    "title": "Galería",
    "category": "cosmos",
    "icon": "format-gallery",
    "description": "Galería de imágenes de hasta cuatro imágenes en una misma fila.",
    "keywords": [
        "galería",
        "imagenes",
        "fotos",
        "gallery",
        "cosmos"
    ],
    "textdomain": "hoteles-cosmos",

    "supports": {
        "anchor": true,
        "html": false
    },

    "attributes": {
        "columns": {
            "type": "number",
            "default": 3
        },

        "widthMode": {
            "type": "string",
            "default": "container"
        },

        "gap": {
            "type": "number",
            "default": 20
        },

        "imageHeight": {
            "type": "number",
            "default": 420
        },

        "borderRadius": {
            "type": "number",
            "default": 0
        },

        "image1Id": {
            "type": "number",
            "default": 0
        },

        "image1Url": {
            "type": "string",
            "default": ""
        },

        "image1Alt": {
            "type": "string",
            "default": ""
        },

        "image2Id": {
            "type": "number",
            "default": 0
        },

        "image2Url": {
            "type": "string",
            "default": ""
        },

        "image2Alt": {
            "type": "string",
            "default": ""
        },

        "image3Id": {
            "type": "number",
            "default": 0
        },

        "image3Url": {
            "type": "string",
            "default": ""
        },

        "image3Alt": {
            "type": "string",
            "default": ""
        },

        "image4Id": {
            "type": "number",
            "default": 0
        },

        "image4Url": {
            "type": "string",
            "default": ""
        },

        "image4Alt": {
            "type": "string",
            "default": ""
        }
    },

    "editorScript": "file:./build/editor.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "render": "file:./render.php"
}