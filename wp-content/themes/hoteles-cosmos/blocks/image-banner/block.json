{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hoteles-cosmos/image-banner",
    "title": "Banner con imagen",
    "category": "cosmos",
    "icon": "format-image",
    "description": "Banner de pantalla completa con imagen, texto y CTA opcional.",
    "keywords": [
        "banner",
        "hero",
        "imagen",
        "cta",
        "cosmos"
    ],
    "textdomain": "hoteles-cosmos",

    "supports": {
        "anchor": true,
        "html": false
    },

    "attributes": {
        "imageId": {
            "type": "number",
            "default": 0
        },

        "imageUrl": {
            "type": "string",
            "default": ""
        },

        "imageAlt": {
            "type": "string",
            "default": ""
        },

        "overlayEnabled": {
            "type": "boolean",
            "default": true
        },

        "overlayColor": {
            "type": "string",
            "default": "#000000"
        },

        "overlayOpacity": {
            "type": "number",
            "default": 35
        },

        "contentPosition": {
            "type": "string",
            "default": "top-left"
        },

        "contentPadding": {
            "type": "number",
            "default": 0
        },

        "text": {
            "type": "string",
            "default": "Escribe tu texto aquí"
        },

        "textSize": {
            "type": "number",
            "default": 48
        },

        "textColor": {
            "type": "string",
            "default": "#ffffff"
        },

        "textWeight": {
            "type": "string",
            "default": "700"
        },

        "textAlign": {
            "type": "string",
            "default": "left"
        },

        "buttonEnabled": {
            "type": "boolean",
            "default": true
        },

        "buttonText": {
            "type": "string",
            "default": "Conoce más"
        },

        "buttonUrl": {
            "type": "string",
            "default": "#"
        },

        "buttonWidth": {
            "type": "number",
            "default": 180
        },

        "buttonHeight": {
            "type": "number",
            "default": 48
        },

        "buttonTextSize": {
            "type": "number",
            "default": 14
        },

        "buttonTextColor": {
            "type": "string",
            "default": "#ffffff"
        },

        "buttonBackground": {
            "type": "string",
            "default": "transparent"
        },

        "buttonBorderColor": {
            "type": "string",
            "default": "#ffffff"
        },

        "buttonBorderWidth": {
            "type": "number",
            "default": 1
        },

        "buttonBorderRadius": {
            "type": "number",
            "default": 0
        },

        "buttonTextWeight": {
            "type": "string",
            "default": "600"
        },

        "buttonMarginTop": {
            "type": "number",
            "default": 25
        }
    },

    "editorScript": "file:./build/editor.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "render": "file:./render.php"
}