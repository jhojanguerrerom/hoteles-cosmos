{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hoteles-cosmos/overlap-content",
    "title": "Imágenes superpuestas y texto",
    "category": "cosmos",
    "icon": "images-alt2",
    "description": "Sección de contenido con dos imágenes superpuestas y contenido de texto.",
    "keywords": [
        "imagenes",
        "superpuestas",
        "texto",
        "contenido",
        "cosmos"
    ],
    "textdomain": "hoteles-cosmos",

    "supports": {
        "anchor": true,
        "html": false
    },

    "attributes": {
        "imageOneId": {
            "type": "number",
            "default": 0
        },
        "imageOneUrl": {
            "type": "string",
            "default": ""
        },
        "imageOneAlt": {
            "type": "string",
            "default": ""
        },

        "imageTwoId": {
            "type": "number",
            "default": 0
        },
        "imageTwoUrl": {
            "type": "string",
            "default": ""
        },
        "imageTwoAlt": {
            "type": "string",
            "default": ""
        },

        "title": {
            "type": "string",
            "default": ""
        },

        "highlight": {
            "type": "string",
            "default": ""
        },

        "content": {
            "type": "string",
            "default": ""
        }
    },

    "editorScript": "file:./build/editor.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "render": "file:./render.php"
}