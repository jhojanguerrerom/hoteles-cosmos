{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hoteles-cosmos/card-grid",
    "title": "Tarjetas Cosmos",
    "category": "cosmos",
    "icon": "screenoptions",
    "description": "Grilla de tarjetas con imagen, texto superpuesto y CTA.",
    "keywords": [
        "tarjetas",
        "cards",
        "hoteles",
        "imagen",
        "cta",
        "cosmos"
    ],
    "textdomain": "hoteles-cosmos",

    "supports": {
        "anchor": true,
        "html": false
    },

    "attributes": {
        "cards": {
            "type": "array",
            "default": []
        },

        "marginTop": {
            "type": "number",
            "default": 50
        },

        "marginBottom": {
            "type": "number",
            "default": 50
        },

        "cardGap": {
            "type": "number",
            "default": 30
        },

        "imageAspectRatio": {
            "type": "string",
            "default": "4/3"
        },

        "overlay": {
            "type": "number",
            "default": 55
        },

        "ctaWidth": {
            "type": "number",
            "default": 90
        },

        "ctaBorderWidth": {
            "type": "number",
            "default": 1
        },

        "ctaBorderRadius": {
            "type": "number",
            "default": 0
        },

        "ctaColor": {
            "type": "string",
            "default": "#111111"
        },

        "ctaBackground": {
            "type": "string",
            "default": "transparent"
        },

        "ctaText": {
            "type": "string",
            "default": "Conoce más"
        }
    },

    "editorScript": "file:./build/editor.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "render": "file:./render.php"
}