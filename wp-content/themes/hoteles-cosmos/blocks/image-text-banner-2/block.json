{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "hoteles-cosmos/image-text-banner-2",
    "title": "Banner imagen y texto",
    "category": "cosmos",
    "icon": "format-image",
    "description": "Banner de ancho completo con imagen de fondo y texto posicionable.",
    "keywords": [
        "banner",
        "imagen",
        "texto",
        "hero",
        "imagen de fondo",
        "cosmos"
    ],
    "textdomain": "hoteles-cosmos",

    "supports": {
        "anchor": true,
        "html": false
    },

    "attributes": {

        "imageId": {
            "type": "number",
            "default": 0
        },

        "imageUrl": {
            "type": "string",
            "default": ""
        },

        "imageAlt": {
            "type": "string",
            "default": ""
        },

        "text": {
            "type": "string",
            "default": "Escribe tu texto"
        },

        "textPosition": {
            "type": "string",
            "default": "center-center"
        },

        "textBackgroundEnabled": {
            "type": "boolean",
            "default": false
        },

        "textBackground": {
            "type": "string",
            "default": "#000000"
        },

        "textBackgroundOpacity": {
            "type": "number",
            "default": 75
        },

        "textColor": {
            "type": "string",
            "default": "#ffffff"
        },

        "textSize": {
            "type": "number",
            "default": 32
        },

        "textWeight": {
            "type": "string",
            "default": "400"
        },

        "textAlign": {
            "type": "string",
            "default": "center"
        },

        "textPadding": {
            "type": "number",
            "default": 20
        },

        "marginTop": {
            "type": "number",
            "default": 50
        },

        "marginBottom": {
            "type": "number",
            "default": 50
        },

        "bannerHeight": {
            "type": "number",
            "default": 450
        },

        "overlay": {
            "type": "number",
            "default": 25
        }

    },

    "editorScript": "file:./build/editor.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "render": "file:./render.php"
}